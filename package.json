{
  "name": "koko-homepage",
  "version": "1.0.0",
  "private": true,
  "description": "Website pribadi dengan komentar sendiri, statistik pengunjung, dan panel admin (tanpa dependensi)",
  "scripts": {
  "start": "node server.js",
  "patch": "node tools/patch-index.js",
  "bundle:client": "esbuild tools/blob-client-entry.js --bundle --format=esm --platform=browser --minify --outfile=public/blob-client.js"
  },
  
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
